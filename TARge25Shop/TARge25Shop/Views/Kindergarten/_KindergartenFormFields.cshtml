@model TARge25Shop.Models.Kindergarten.KindergartenFormViewModel

<div class="form-group row">
    <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="GroupName" class="form-control" id="CU_GroupNameEntry" />
    </div>
</div>
    
<div class="form-group row">
    <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="ChildrenCount" class="form-control" id="CU_ChildrenCountEntry" />
    </div>
</div>
    
<div class="form-group row">
    <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="KindergartenName" class="form-control" id="CU_KindergartenNameEntry" />
    </div>
</div>

<div class="form-group row">
    <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="TeacherName" class="form-control" id="CU_TeacherNameEntry" />
    </div>
</div>

<div class="form-group row">
    <label asp-for="Files" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-5">
        <input class="form-control" asp-for="Files" multiple type="file" />
    </div>
</div>