@using TARge25Shop.Core.Domain
@model IEnumerable<TARge25Shop.Models.Kindergarten.KindergartenIndexViewModel>

<div>
    <h1>Kindergartens Index</h1>
    <a asp-action="Create"
       asp-controller="Kindergarten"
       class="btn btn-primary"
       id="CreateInIndex">
        Create
    </a>
</div>

<div>
    <h2>All kindergartens</h2>
    <form method="get">
        <table class="table table-hover" id="IndexTable">
            <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Group name</th>
                <th scope="col">Number of children</th>
                <th scope="col">Kindergarten name</th>
                <th scope="col">Teacher name</th>
                <th scope="col">Foundation date</th>
                <th scope="col">Actions</th>
            </tr>
            </thead>
            <tbody>
            @{ int i = 1; }
            @foreach (var kindergarten in Model)
            {
                <tr>
                    <td>@(i++)</td>
                    <td id="IndexGroupName">@kindergarten.GroupName</td>
                    <td id="IndexChildrenCount">@kindergarten.ChildrenCount</td>
                    <td id="IndexKindergartenName">@kindergarten.KindergartenName</td>
                    <td id="IndexTeacherName" >@kindergarten.TeacherName</td>
                    <td>@kindergarten.CreatedAt</td>
                    <td id="IndexActionKindergarten">
                        <a asp-action="details" asp-controller="Kindergarten" asp-route-id="@kindergarten.Id" 
                           class="btn btn-primary" id="IndexKindergartenDetails">Details</a>
                        <a asp-action="update" asp-controller="Kindergarten" asp-route-id="@kindergarten.Id" 
                           class="btn btn-primary" id="IndexKindergartenUpdate">Update</a>
                        <a asp-action="delete" asp-controller="Kindergarten" asp-route-id="@kindergarten.Id" 
                           class="btn btn-outline-danger" id="IndexKindergartenDelete">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </form>
</div>