@model TARge25Shop.Models.Kindergarten.ImageViewModel

@{
    var photoPaths = "~/multipleFileUpload/" + (Model.FilePath ?? "noimage.jpg");
}

<div class="image-wrapper">
    <div class="text-truncate text-muted small mb-1">@Model.FilePath</div>
    <img class="img-fluid rounded" src="@photoPaths" asp-append-version="true" alt="Kindergarten image" />
</div>