@model TARge25Shop.Models.Kindergarten.KindergartenDetailsViewmodel

<div>
    <h1>Details</h1>

    <div id="Details_List">
        <h4>Kindergarten</h4>
        <hr/>
        <dl class="row">
            <div class="form-group row">
                <label asp-for="Id" class="col-sm-2 col-form-label"></label>
                <span id="Details_KindergartenId">@Model.Id</span>           
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
                <span id="Details_KindergartenGroupName">@Model.GroupName</span>
            </div>
        </dl>
        
        <dl class="row">
            <div class="form-group row">
                <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
                <span id="Details_KindergartenChildrenCount">@Model.ChildrenCount</span>
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
                <span id="Details_KindergartenName">@Model.KindergartenName</span>
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
                <span id="Details_KindergartenTeacherName">@Model.TeacherName</span>
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.CreatedAt)
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="UpdatedAt" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.UpdatedAt)
            </div>
        </dl>
        
        <div class="form-group row my-4">
            @foreach (var images in Model.Images)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 p-2">
                        <partial name="_Images" model="images" />
                    </div>
                </div>
            }
        </div>
        
        <a asp-action="Index" asp-controller="Kindergarten" class="btn btn-secondary">Back to list</a>
    </div>
</div>