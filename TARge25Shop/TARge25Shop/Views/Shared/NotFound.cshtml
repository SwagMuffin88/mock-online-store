
@{
    ViewData["Title"] = "404 – Item not found";
    var requestedPath = ViewBag.RequestedPath as string;
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <p class="display-1 fw-bold text-primary mb-2">404</p>
            <h1 class="h3 mb-3">Lehte ei leitud</h1>
            <p class="text-muted mb-4">
                The page you are looking for was not found. The URL might be expired, changed or incorrect.
            </p>

            @if (!string.IsNullOrWhiteSpace(requestedPath))
            {
                <div class="alert alert-light border small text-break mb-4">
                    <strong>Requested URL:</strong> @requestedPath
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    Home
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                    Back
                </button>
            </div>
        </div>
    </div>
</div>