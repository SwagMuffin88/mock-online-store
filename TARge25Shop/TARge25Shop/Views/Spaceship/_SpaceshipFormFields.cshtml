@model TARge25Shop.Models.Spaceship.SpaceshipFormViewModel

<div class="form-group row">
    <label asp-for="Name" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="Name" id="CU_NameEntrySpaceship" class="form-control" />
    </div>
</div>

<div class="form-group row">
    <label asp-for="ShipType" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="ShipType" id="CU_ShipTypeEntrySpaceship" class="form-control" />
    </div>
</div>

<div class="form-group row">
    <label asp-for="MaxCrewSize" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="MaxCrewSize" id="CU_CrewEntrySpaceship"  class="form-control" />
    </div>
</div>
    
<div class="form-group row">
    <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="EnginePower" id="CU_EnginePowerEntrySpaceship" class="form-control" />
    </div>
</div>
    
<div class="form-group row">
    <label asp-for="Files" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-5">
        <div class="custom-file">
            <input class="form-control" asp-for="Files" id="CU_FilesEntrySpaceship" multiple type="file" />
        </div>
    </div>
</div>