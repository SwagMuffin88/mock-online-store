@model TARge25Shop.Models.Spaceship.SpaceshipUpdateViewmodel

<h1>
    Update
</h1>

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <partial name="_SpaceshipFormFields" model="Model"/>
    
    @foreach (var images in Model.Images)
    {
        <partial name="_Images" model="images" /> 
        <input  asp-action="removeImage" asp-controller="spaceship" asp-route-imageId="@images.ImageId" 
                type="submit" class="btn btn-danger" value="Remove Image"/>
    }
    
    <input asp-action="update" asp-controller="spaceship" type="submit" class="btn btn-success" value="Update" />    
    
    <a asp-action="Index" asp-controller="spaceship" class="btn btn-secondary">Back to List</a>

</form>