@using TARge25Shop.Core.Domain
@model TARge25Shop.Models.Spaceship.SpaceshipCreateViewModel
@* todo rename model *@

<div>
    <h1>Spaceships Index</h1>

    <a asp-action="CreateIndex"
       asp-controller="Spaceship"
       type="submit"
       class="btn btn-primary">Create
    </a>
</div>
<div>
    <h2>All spaceships</h2>
    <form method="get">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Nr</th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Build date</th>
                    <th scope="col">Crew</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var spaceship in Model) {
                <tr>
                    <td>Spaceship nr.</td>
                    <td>@spaceship.Name</td>
                </tr>
            }
            </tbody>

        </table>
    </form>
</div>