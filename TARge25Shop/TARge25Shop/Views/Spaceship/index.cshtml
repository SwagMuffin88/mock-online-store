@using TARge25Shop.Core.Domain
@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

<div>
    <h1>Spaceships Index</h1>
    <a asp-action="Create"
       asp-controller="Spaceship"
       class="btn btn-primary">
        Create
    </a>
</div>

<div>
    <h2>All spaceships</h2>
    <form method="get">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Nr</th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Build date</th>
                    <th scope="col">Crew</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
            @{ int i = 1; }
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td>@(i++)</td>
                    <td>@spaceship.Name</td>
                    <td>@spaceship.ShipType</td>
                    <td>@spaceship.CreatedAt</td>
                    <td>@spaceship.MaxCrewSize</td>
                    <td>
                        <a asp-action="Details" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-primary">Details</a>
                        <a asp-action="update" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-primary">Update</a>
                        <a asp-action="delete" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>

        </table>
    </form>
</div>